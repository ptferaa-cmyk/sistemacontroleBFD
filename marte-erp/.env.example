# Banco de dados PostgreSQL (ajuste usuário, senha e porta conforme sua instalação)
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/estoque?schema=public"

# Segredo JWT — OBRIGATÓRIO trocar antes de colocar em produção
# Gere um valor seguro: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-para-um-valor-secreto-longo-e-aleatorio"

# Porta do servidor Express (padrão: 8000)
PORT=8000

# Origens permitidas pelo CORS (separadas por vírgula)
# Em produção, coloque a URL real do frontend
CORS_ORIGINS=http://localhost:3000
